{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Launch Nest (npm start:debug)",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run-script", "start:debug"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
        "autoAttachChildProcesses": true,
        "sourceMaps": true
      }
    ]
  }
  